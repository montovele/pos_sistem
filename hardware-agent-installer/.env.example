HARDWARE_AGENT_HOST=127.0.0.1
HARDWARE_AGENT_PORT=18181
HARDWARE_AGENT_TOKEN=
HARDWARE_AGENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Usa "auto" para una impresora instalada en Windows o una cola CUPS en Linux.
# Usa "network" para una impresora ESC/POS conectada por TCP.
HARDWARE_PRINTER_TRANSPORT=mock
HARDWARE_PRINTER_NAME=AUTO
HARDWARE_PRINTER_HOST=127.0.0.1
HARDWARE_PRINTER_PORT=9100

SCALE_ENABLED=false
SCALE_PORT=
SCALE_BAUD_RATE=9600
SCALE_DATA_BITS=8
SCALE_STOP_BITS=1
SCALE_PARITY=none
SCALE_UNIT=kg
SCALE_READ_TIMEOUT_MS=2500
SCALE_STABLE_READS=2
